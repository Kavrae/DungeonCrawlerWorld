<Project>

  <!--
    Nullable warnings fail the build: non-nullable types are the guarantee that a dependency is
    present, in place of runtime null guards, so a nullable warning is a broken guarantee.
  -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>

  <!--
    The engine's analyzers (Cadence/Analyzers) run in every project but themselves and their tests, which load them as a
    library instead. CAD0001: a component write scope must be held in a using.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Analyzers' and '$(MSBuildProjectName)' != 'Analyzers.Tests'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Cadence\Analyzers\Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
