<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Wall-clock performance checks are opt-in: they assert timing ratios, so running them
      alongside the rest of the suite (in parallel, contending for the same cores) makes them
      flake. Passing a filter sets this same property on the command line, where it replaces this
      default rather than combining with it, so an explicit filter is what runs them. A
      runsettings TestCaseFilter would not work: VSTest ANDs that one with the command line's.
    -->
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">TestCategory!=Performance</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine\Engine.csproj" />
    <ProjectReference Include="..\Game\Game.csproj" />
    <ProjectReference Include="..\Presentation\Presentation.csproj" />
    <!--
      Build-order only: GameBootstrapperTests/ModuleLoaderTests load Mods.ExampleMod.dll at
      runtime via reflection (the real modding pipeline), not by compile-time reference.
      ReferenceOutputAssembly=false keeps its types out of Tests' own compilation so that
      pipeline is what's actually being exercised, while still guaranteeing it's built
      before Tests runs.
    -->
    <ProjectReference Include="..\Mods\Mods.ExampleMod\Mods.ExampleMod.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Mods\Mods.TestFixtures\Mods.TestFixtures.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
