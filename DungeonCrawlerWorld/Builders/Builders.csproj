<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DungeonCrawlerWorld's IDE tabs: the Items, Actions and Auras builders, shown in Cadence Workshop's shell. Each tab
    reads the game through a GameSession and shows records with the game's own Presentation windows.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FNA.NET" Version="2.1.2.2506" />
    <PackageReference Include="FNA.NET.FontStashSharp" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Cadence\Engine\Engine.csproj" />
    <ProjectReference Include="..\..\Cadence\UIEngine\UIEngine.csproj" />
    <ProjectReference Include="..\..\Cadence\Workshop\Workshop.csproj" />
    <ProjectReference Include="..\Game\Game.csproj" />
    <ProjectReference Include="..\Presentation\Presentation.csproj" />
  </ItemGroup>

</Project>
