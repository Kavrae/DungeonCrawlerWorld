<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="Fonts\license.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <Content Include="SpriteManifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!--
      A single recursive wildcard rather than one entry per file: SpriteManifestBuilder (see
      Cadence/Tools) can reference any PNG under this folder, from any vendored pack, at any time.
      Enumerating files individually here meant every new manifest entry needed a matching
      manual csproj edit too, and forgetting one is exactly what a missing-file exception at
      runtime looks like (a real bug hit in practice, not hypothetical).
    -->
    <!--
      The game's own compiled effects (fx_2_0, SpriteEffectService.Load); an Effects\SpriteUber.fxb replaces UIEngine's
      embedded sprite effect when it declares the same vertex version. None ship yet.
    -->
    <Content Include="Effects\*.fxb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Spritesheets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="Spritesheets\Pixel Crawler - Free Pack\Terms.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!--
      The master manifest of actions, items, auras and areas ships; Definitions\Drafts (the IDE's work in progress)
      never does: only the Master folder is copied, so nothing the game loads can be a draft.
    -->
    <Content Include="Definitions\Master\**\*.jsonl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Definitions\Master\Areas\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
