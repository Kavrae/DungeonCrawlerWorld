<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same reasoning as Mods.ExampleMod.csproj: a mod resolves Engine/Game against the
         host process's already-loaded copies rather than shipping its own. -->
    <ProjectReference Include="..\..\..\Cadence\Engine\Engine.csproj" Private="false" />
    <ProjectReference Include="..\..\Game\Game.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content-only mods that fail: one record that won't load, one area holding an undefined symbol. Copied as a folder into a mods directory, each must be dropped, naming its file and line (and the area's column). -->
    <None Include="BrokenContentMod\**\*.jsonl;BrokenAreaMod\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
