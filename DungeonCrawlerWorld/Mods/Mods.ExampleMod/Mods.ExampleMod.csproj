<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Private=false: a real mod must not ship its own copy of Engine.dll/Game.dll next to
      itself in Mods/, or ModuleLoader would try to load those copies too (Game.dll alone
      defines every built-in module), and a duplicate IModule type loaded into its own
      AssemblyLoadContext is a distinct Type from the host process's, breaking the
      typeof(IModule).IsAssignableFrom check entirely. A mod resolves these against the
      copies the host process already has loaded, exactly like a Minecraft mod resolves
      against the game's own classes instead of shipping its own.
    -->
    <ProjectReference Include="..\..\..\Cadence\Engine\Engine.csproj" Private="false" />
    <ProjectReference Include="..\..\Game\Game.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The mod's content: a Mod content layer the game reads from Definitions beside the DLL (ModuleLoader.LoadMods). -->
    <None Include="Definitions\**\*.jsonl;Definitions\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    dotnet build -p:DeployToGame=true installs the built mod, the DLL and its Definitions folder, as the player would:
    into %LocalAppData%\DungeonCrawlerWorld\Mods\ExampleMod (Game.Bootstrap.PlayerFolders.Mods), which every build of the
    game loads at start. The folder is emptied first, so it always holds exactly this build.
  -->
  <PropertyGroup>
    <InstalledModDirectory>$([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData))\DungeonCrawlerWorld\Mods\ExampleMod\</InstalledModDirectory>
  </PropertyGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <ItemGroup>
      <ModOutputFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(InstalledModDirectory)" />
    <Copy SourceFiles="@(ModOutputFiles)" DestinationFiles="@(ModOutputFiles->'$(InstalledModDirectory)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="ExampleMod installed in $(InstalledModDirectory)" />
  </Target>

</Project>
