<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone dev tool. Its only reference is SpriteFormat, the dependency-free library that holds the manifest's
    model, JSON, load checks, reach box, link masks and placement: the same code the game loads the manifest with,
    so what this tool saves is what the game accepts. No Game, Engine, Presentation or FNA. Not referenced by
    DungeonCrawlerWorld.csproj: this never ships with or runs as part of the game.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SpriteFormat\SpriteFormat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SpriteFormat" />
  </ItemGroup>

</Project>
